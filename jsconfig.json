{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "jsx": "preserve",
        "baseUrl": "src",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src/"],
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}